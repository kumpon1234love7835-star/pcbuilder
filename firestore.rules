rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'kommay940@gmail.com';
    }

    match /builds/{id} {
      // ลูกค้า (ไม่ต้องล็อกอิน): สร้างได้อย่างเดียว และเครื่องที่ถูกบล็อกจะสร้างไม่ได้
      allow create: if request.resource.data.keys().hasOnly(
          ['rid','name','lv','yr','dept','device','budget','pur','cond','total','items','cool','rev','did','dev','ts'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.dept is string && request.resource.data.dept.size() <= 60
        && request.resource.data.items is list && request.resource.data.items.size() <= 15
        && request.resource.data.total is number
        && request.resource.data.did is string && request.resource.data.did.size() > 8 && request.resource.data.did.size() <= 40
        && request.resource.data.dev is string && request.resource.data.dev.size() <= 100
        && !exists(/databases/$(database)/documents/blocked/$(request.resource.data.did))
        && request.resource.data.ts == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // รายการเครื่องที่ถูกบล็อก: จัดการได้เฉพาะแอดมิน
    match /blocked/{did} {
      allow read, create, update, delete: if isAdmin();
    }
  }
}
